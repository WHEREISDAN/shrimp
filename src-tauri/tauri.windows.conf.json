{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shrimp",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": ["nsis"],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../scripts/windows/sign.ps1",
          "%1"
        ]
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh",
        "languages": ["English", "German", "Spanish", "Italian", "PortugueseBR"]
      }
    }
  }
}
