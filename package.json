{
  "name": "shrimp",
  "private": true,
  "version": "0.1.1",
  "description": "Speech to text, anywhere: a desktop dictation app for macOS and Windows.",
  "license": "MIT",
  "homepage": "https://github.com/WHEREISDAN/shrimp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WHEREISDAN/shrimp.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm clippy && pnpm test:rust",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.conf.dev.json",
    "app:dev": "scripts/macos/dev-app.sh build",
    "app:dev:open": "scripts/macos/dev-app.sh open",
    "regression:mac": "scripts/macos/regression/run.sh",
    "app:dev:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/dev-app.ps1 build",
    "app:dev:win:open": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/dev-app.ps1 open",
    "release:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/release.ps1",
    "regression:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/regression/run.ps1",
    "notices": "node scripts/notices.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "26.4.4",
    "lucide-react": "^1.57.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "17.0.16",
    "tauri-plugin-mcp": "^0.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.14.0",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
